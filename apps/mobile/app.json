{
  "expo": {
    "name": "Élan",
    "slug": "elan",
    "scheme": "elan",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1220",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.elan.training",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.elan.training",
      "adaptiveIcon": {
        "backgroundColor": "#0E1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1220",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "description": "Programme de musculation, cardio et nutrition sur 26 semaines, guidé série par série.",
    "owner": "alex60s-team",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "89cb6ae4-e6af-447f-86c8-c73ab9f3e6ce"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/89cb6ae4-e6af-447f-86c8-c73ab9f3e6ce"
    },
    "runtimeVersion": "exposdk:58.0.0"
  }
}
