  "techniques": [
    {
      "id": "sq",
      "name": "Squat goblet",
      "text": "Haltère contre la poitrine, pieds un peu plus larges que les épaules, talons au sol. Descends dos droit jusqu’aux cuisses parallèles."
    },
    {
      "id": "br",
      "name": "Pont fessier / hip thrust",
      "text": "Pieds à plat, serre les fessiers pour monter le bassin jusqu’à l’alignement épaules-hanches-genoux. Ne cambre pas le bas du dos."
    },
    {
      "id": "pu",
      "name": "Pompes",
      "text": "Corps gainé en planche, coudes à 45°. Descends la poitrine près du sol, repousse sans creuser le dos. Sur les genoux si besoin. Version explosive : seulement avec une bonne technique."
    },
    {
      "id": "bp",
      "name": "Développé couché",
      "text": "Omoplates serrées, pieds au sol. Descends la charge vers le bas des pecs, coudes à 45°, pousse en expirant."
    },
    {
      "id": "ro",
      "name": "Rowing",
      "text": "Buste penché, dos plat, genoux fléchis. Tire le coude vers la hanche et serre les omoplates. Prends la version appuyée si ton dos est sensible."
    },
    {
      "id": "op",
      "name": "Développé épaules",
      "text": "Gainé, sans cambrer. Pousse au-dessus de la tête puis redescends à hauteur des oreilles."
    },
    {
      "id": "cu",
      "name": "Curl biceps",
      "text": "Coudes collés au corps, sans élan. Monte en expirant, redescends en 2–3 s."
    },
    {
      "id": "pl",
      "name": "Planche",
      "text": "Avant-bras au sol, corps aligné de la tête aux talons, ventre et fessiers serrés. Ne creuse pas le dos : très bon pour protéger les lombaires."
    }
  ],
