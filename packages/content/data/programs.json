{
  "goals": {
    "mass": {
      "name": "Prise de masse",
      "icon": "💪",
      "description": "Construire du muscle et du poids. Séries de 8 à 12 répétitions, charges qui montent.",
      "weightGoalText": "gain visé : 0,25 à 0,5 kg par semaine",
      "phaseTexts": [
        "Apprendre : 2–3 séries de 10–12 reps, 3–4 reps en réserve",
        "Progresser : 3–4 séries de 8–12 reps, nouveaux exercices, +2 kg dès que possible",
        "Intensifier : 3–4 séries de 6–10 reps, charges plus lourdes"
      ],
      "nutritionNotes": {
        "before": "1 h 30 avant : féculents + protéines (porridge, riz + poulet). 30 min avant si besoin : une banane.",
        "after": "Dans l’heure : 25–35 g de protéines + glucides (smoothie, riz + poulet, fromage blanc + flocons).",
        "adjust": "Poids stable 2 semaines : +200 kcal (flocons au lait + banane). Plus de 0,5 kg par semaine : retire 150 kcal."
      }
    },
    "strength": {
      "name": "Force",
      "icon": "🏋️",
      "description": "Devenir plus fort sur les mouvements de base. Séries courtes de 3 à 8 répétitions, repos longs.",
      "weightGoalText": "gain visé : 0,1 à 0,25 kg par semaine",
      "phaseTexts": [
        "Bases : 4 × 6–8, technique, repos 2 min",
        "Force : 5 × 5, repos 3 min, charges lourdes",
        "Pic : 5 × 3–5, dernière série à fond"
      ],
      "nutritionNotes": {
        "before": "2 h avant : féculents + protéines, pas de séance lourde à jeun.",
        "after": "Protéines + glucides dans les 2 h. Créatine monohydrate 3 g par jour : optionnelle et la plus étudiée (avis médical en cas de doute).",
        "adjust": "Poids et force stables 3 semaines : +150 kcal."
      }
    },
    "power": {
      "name": "Explosivité",
      "icon": "⚡",
      "description": "Sauter plus haut, accélérer, lancer plus fort. Mouvements rapides et sauts, 60 contacts au sol maximum par séance.",
      "weightGoalText": "poids stable à ±1 kg",
      "phaseTexts": [
        "Technique : sauts et lancers de qualité, 4 × 5, repos 90 s",
        "Puissance : 5 × 4, plus de vitesse",
        "Pic : 6 × 3, qualité maximale, 60 contacts au sol max"
      ],
      "nutritionNotes": {
        "before": "60 à 90 min avant : glucides rapides (pain + banane) pour sauter et courir frais. Pas de séance explosive à jeun ni juste après un gros repas.",
        "after": "Protéines + glucides dans l’heure.",
        "adjust": "Si tu perds du poids 2 semaines de suite : +150 kcal."
      }
    },
    "cardio": {
      "name": "Cardio",
      "icon": "🫁",
      "description": "Souffle et endurance : footing, vélo, fractionné progressif, un peu de renforcement.",
      "weightGoalText": "poids stable à ±1 kg",
      "phaseTexts": [
        "Base : endurance facile 25 min, fractionné doux",
        "Endurance : 35 min, fractionné 30 s / 90 s",
        "Souffle : 45 min, fractionné 45 s / 75 s, +10 % de volume max par semaine"
      ],
      "nutritionNotes": {
        "before": "1 à 2 h avant : féculents faciles (riz, banane, pain) et 300–500 ml d’eau.",
        "after": "20–30 g de protéines + glucides + eau dans l’heure. Sorties de plus de 60 min : bois pendant l’effort et ajoute 30–60 g de glucides par heure.",
        "adjust": "Poids qui baisse 2 semaines de suite : +150 kcal."
      }
    }
  },
